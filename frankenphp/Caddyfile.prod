{
	frankenphp {
		worker {
			file ./public/index.php
			num {$FRANKENPHP_WORKERS:4}
			env APP_RUNTIME Runtime\FrankenPhpSymfony\Runtime
		}
	}

	auto_https off
	http_port 8080
}

:8080 {
	root * /app/public

	encode zstd gzip

	# Security headers
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Mercure hub
	mercure {
		anonymous
		publisher_jwt {env.MERCURE_JWT_SECRET}
		subscriber_jwt {env.MERCURE_JWT_SECRET}
		cors_origins {env.CORS_ORIGIN}
	}

	# Static assets with immutable cache
	@versioned {
		file
		path_regexp \.[\da-f]{8}\.(css|js)$
	}
	@static {
		file
		path *.css *.js *.ico *.jpg *.jpeg *.png *.svg *.gif *.webp *.woff *.woff2 *.ttf *.eot
	}
	handle @versioned {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle @static {
		header Cache-Control "public, max-age=2592000"
		file_server
	}

	php_server {
		resolve_root_symlink false
	}
}
