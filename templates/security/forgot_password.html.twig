{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublie{% endblock %}

{% block body %}
<div class="flex min-h-[calc(100vh-12rem)] items-center justify-center px-4">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8">
            <h2 class="text-2xl font-bold text-gray-900 text-center mb-2">Mot de passe oublie</h2>
            <p class="text-sm text-gray-600 text-center mb-8">Entrez votre email pour recevoir un lien de reinitialisation.</p>

            {{ form_start(form, {'attr': {'class': 'space-y-5'}}) }}
                <div>
                    {{ form_label(form.email, null, {'label_attr': {'class': 'block text-sm font-medium text-gray-700 mb-1'}}) }}
                    {{ form_widget(form.email, {'attr': {'class': 'w-full rounded-lg border border-gray-300 px-3 py-2.5 text-sm focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200 outline-none transition-all', 'placeholder': 'votre@email.fr'}}) }}
                    {{ form_errors(form.email, {'attr': {'class': 'mt-1 text-sm text-red-600'}}) }}
                </div>

                <button type="submit" class="w-full rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 transition-colors">
                    Envoyer le lien
                </button>
            {{ form_end(form) }}

            <p class="mt-6 text-center text-sm text-gray-500">
                <a href="{{ path('app_login') }}" class="font-medium text-indigo-600 hover:text-indigo-500">&larr; Retour a la connexion</a>
            </p>
        </div>
    </div>
</div>
{% endblock %}
