{% extends 'admin/base.html.twig' %}

{% block page_title %}Dashboard{% endblock %}

{% block content %}
{# Server Info Cards #}
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="bg-white rounded-lg border border-gray-200 p-5">
        <p class="text-sm font-medium text-gray-500">PHP</p>
        <p class="mt-1 text-2xl font-semibold text-gray-900">{{ server.php_version }}</p>
        <p class="mt-1 text-xs text-gray-400">{{ server.php_sapi }}</p>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 p-5">
        <p class="text-sm font-medium text-gray-500">Symfony</p>
        <p class="mt-1 text-2xl font-semibold text-gray-900">{{ server.symfony_version }}</p>
        <p class="mt-1 text-xs text-gray-400">{{ server.os }}</p>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 p-5">
        <p class="text-sm font-medium text-gray-500">Memoire</p>
        <p class="mt-1 text-2xl font-semibold text-gray-900">{{ memory.usage }}</p>
        <p class="mt-1 text-xs text-gray-400">Pic: {{ memory.peak }} / Limite: {{ memory.limit }}</p>
    </div>
    <div class="bg-white rounded-lg border border-gray-200 p-5">
        <p class="text-sm font-medium text-gray-500">Disque</p>
        <p class="mt-1 text-2xl font-semibold text-gray-900">{{ disk.used_percent }}%</p>
        <div class="mt-2 w-full bg-gray-200 rounded-full h-2">
            <div class="bg-{{ disk.used_percent > 90 ? 'red' : (disk.used_percent > 70 ? 'yellow' : 'green') }}-500 h-2 rounded-full" style="width: {{ disk.used_percent }}%"></div>
        </div>
        <p class="mt-1 text-xs text-gray-400">{{ disk.free }} libre / {{ disk.total }}</p>
    </div>
</div>

{# Uptime #}
<div class="bg-white rounded-lg border border-gray-200 p-5 mb-8">
    <p class="text-sm font-medium text-gray-500">Uptime serveur</p>
    <p class="mt-1 text-lg font-semibold text-gray-900">{{ uptime }}</p>
</div>

{# Services Status #}
<div class="bg-white rounded-lg border border-gray-200 mb-8">
    <div class="px-5 py-4 border-b border-gray-200">
        <h2 class="text-base font-semibold text-gray-900">Status des services</h2>
    </div>
    <div class="divide-y divide-gray-200">
        {% for name, service in services %}
        <div class="px-5 py-3 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="h-2.5 w-2.5 rounded-full {{ service.status == 'ok' or service.status == 'configured' ? 'bg-green-500' : (service.status == 'error' ? 'bg-red-500' : 'bg-yellow-500') }}"></div>
                <span class="text-sm font-medium text-gray-900">{{ name|capitalize }}</span>
            </div>
            <span class="text-sm text-gray-500 max-w-md truncate">{{ service.details }}</span>
        </div>
        {% endfor %}
    </div>
</div>

{# Recent Users #}
<div class="bg-white rounded-lg border border-gray-200">
    <div class="px-5 py-4 border-b border-gray-200">
        <h2 class="text-base font-semibold text-gray-900">Derniers utilisateurs inscrits</h2>
    </div>
    <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
            <tr>
                <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase">ID</th>
                <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase">Email</th>
                <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase">Verifie</th>
                <th class="px-5 py-3 text-left text-xs font-medium text-gray-500 uppercase">Inscrit le</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-gray-200">
            {% for user in recent_users %}
            <tr>
                <td class="px-5 py-3 text-sm text-gray-500">{{ user.id }}</td>
                <td class="px-5 py-3 text-sm text-gray-900">{{ user.email }}</td>
                <td class="px-5 py-3">
                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium {{ user.verified ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' }}">
                        {{ user.verified ? 'Oui' : 'Non' }}
                    </span>
                </td>
                <td class="px-5 py-3 text-sm text-gray-500">{{ user.createdAt ? user.createdAt|date('d/m/Y H:i') : '-' }}</td>
            </tr>
            {% else %}
            <tr>
                <td colspan="4" class="px-5 py-8 text-center text-sm text-gray-500">Aucun utilisateur inscrit.</td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
