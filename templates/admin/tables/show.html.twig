{% extends 'admin/base.html.twig' %}

{% block page_title %}Table: {{ table_name }}{% endblock %}

{% block content %}
<div class="mb-4">
    <a href="{{ path('app_admin_tables') }}" class="text-sm text-indigo-600 hover:text-indigo-500">&larr; Retour aux tables</a>
</div>

<div class="bg-white rounded-lg border border-gray-200">
    <div class="px-5 py-4 border-b border-gray-200 flex items-center justify-between">
        <h2 class="text-base font-semibold text-gray-900">{{ table_name }}</h2>
        <span class="text-sm text-gray-500">{{ rows|length }} ligne{{ rows|length > 1 ? 's' : '' }} (max 100)</span>
    </div>

    {% if rows is empty %}
        <div class="px-5 py-12 text-center text-sm text-gray-500">Table vide.</div>
    {% else %}
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        {% for column in columns %}
                        <th class="px-4 py-3 text-left text-xs font-medium text-gray-500 uppercase whitespace-nowrap">
                            {{ column.name }}
                            <span class="font-normal text-gray-400 lowercase">({{ column.type }})</span>
                        </th>
                        {% endfor %}
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    {% for row in rows %}
                    <tr class="hover:bg-gray-50">
                        {% for column in columns %}
                        <td class="px-4 py-2 text-sm text-gray-700 max-w-xs truncate">
                            {% set val = row[column.name] %}
                            {% if val is null %}
                                <span class="text-gray-300 italic">null</span>
                            {% elseif val is same as(true) %}
                                <span class="text-green-600">true</span>
                            {% elseif val is same as(false) %}
                                <span class="text-red-600">false</span>
                            {% else %}
                                {{ val }}
                            {% endif %}
                        </td>
                        {% endfor %}
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
{% endblock %}
