{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mt-4">
            <div class="rounded-lg p-4 {{ type == 'success' ? 'bg-green-50 text-green-800 border border-green-200' : (type == 'error' ? 'bg-red-50 text-red-800 border border-red-200' : 'bg-blue-50 text-blue-800 border border-blue-200') }}">
                <p class="text-sm font-medium">{{ message }}</p>
            </div>
        </div>
    {% endfor %}
{% endfor %}
